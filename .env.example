# kohls-scraper configuration. Copy to `.env` and fill in:
#
#     cp .env.example .env
#
# Values are read by env_config.py, which treats every value below as UNSET
# (a placeholder, not a credential). A real value replaces the whole
# placeholder, braces included. Credentials belong here, never on the command
# line, where `ps` and shell history would keep them.

# 2Captcha API key. Needed only for --solve-captcha and --fingerprint.
# On kohls.com the paid product the site actually serves is the Scraping
# Browser API below; Akamai's refusal page carries no captcha to solve.
TWOCAPTCHA_KEY=your_api_key_here

# The 2Captcha Scraping Browser API CDP endpoint (--cdp-endpoint). Fill in the
# login, profile id and password from your dashboard, keeping the host.
KOHLS_CDP_ENDPOINT=ws://{login}-zone-scraping_browser-country-us-pid-{profileId}:{password}@cb.2captcha.com:9222

# A single authenticated proxy (--proxy), or use --proxy-file for a pool.
KOHLS_PROXY=http://{user}:{password}@eu.proxy.2captcha.com:2334

# The listing or product URL to scrape (--url). Keep the CN= filter on a
# category URL; it is what selects the category.
KOHLS_URL=
