# Node server configuration. Copy to .env and adjust; never commit real secrets.
# DATA_MODE selects the built data: demo (bundled sample) or live (collected snapshot).
DATA_MODE=demo
# HOST=127.0.0.1
# PORT=8080
# ENABLE_RADAR=1
# Live mode reads the snapshot built by the collector from this seed file.
# FTSHARE_SEED_FILE=data/private/seed.json
# The provider key is read at collection time only, never shipped to browsers.
# Prefer FTSHARE_API_KEY_FILE over embedding the key here.
# FTSHARE_API_KEY=
# FTSHARE_API_KEY_FILE=
