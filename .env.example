# .env.example — copy to .env and fill in what you use.
#
# Nothing here is read as a credential until you replace it: the values are
# vendor-documented SHAPES with the parts you fill in in braces, and
# env_config.py treats any `{...}` left in a value as "never filled in".
#
#     cp .env.example .env
#     python3 env_config.py         # prints what was picked up, never the secrets
#
# A key typed on the command line always wins over this file, and an exported
# environment variable wins over the file too.

# 2captcha API key, for solving a reCAPTCHA / Turnstile if one appears, and
# for the Fingerprint API (--fingerprint uses the same key, though it is a
# separate subscription from solving).
TWOCAPTCHA_KEY=your_2captcha_api_key_here

# A browser already running behind a CDP endpoint, e.g. the 2Captcha Scraping
# Browser API. When set, the run attaches to it instead of launching a local
# browser.
OPENSEA_CDP_ENDPOINT=ws://{login}-zone-scraping_browser-country-id-pid-{profileId}:{password}@cb.2captcha.com:9222

# One proxy exit for the whole run. Leave it out to use your own IP.
OPENSEA_PROXY=http://{user}:{password}@ap.proxy.2captcha.com:2334

# A default URL for a bare run (no --url, --collection or --mode). SHIPPED
# COMMENTED OUT on purpose: an environment URL used to outrank --collection
# and --mode collections, which made a builder flag silently read another
# collection.
#OPENSEA_URL=https://opensea.io/collection/boredapeyachtclub
