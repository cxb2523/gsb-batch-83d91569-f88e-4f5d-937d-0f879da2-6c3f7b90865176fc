# Copy to .env on the deployment Mac. Keep the actual API key in the local file below.
DATA_MODE=live
FTSHARE_SEED_FILE=data/private/seed.json
ENABLE_RADAR=0
FTSHARE_LIVE_CACHE_FILE=data/private/live-cache.json
FTSHARE_API_KEY_FILE=data/private/api-key.txt
HOST=127.0.0.1
PORT=8080
# Only trust forwarding from Caddy on this same Mac, never arbitrary LAN peers.
TRUST_LOOPBACK_PROXY=1
API_REQUESTS_PER_MINUTE=180
API_CONCURRENCY=32
UPSTREAM_REQUESTS_PER_MINUTE=1200
UPSTREAM_CONCURRENCY=32
