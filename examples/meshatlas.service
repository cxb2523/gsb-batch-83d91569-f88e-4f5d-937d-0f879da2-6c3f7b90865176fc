# systemd user service for MeshAtlas.
#   install:  pipx install meshatlas   (or: uv tool install meshatlas)
#   copy to:  ~/.config/systemd/user/meshatlas.service
#   enable:   systemctl --user daemon-reload && systemctl --user enable --now meshatlas
#             loginctl enable-linger "$USER"     # keep it running after you log out
[Unit]
Description=MeshAtlas - live map of the tailnet
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
ExecStart=%h/.local/bin/meshatlas run
Restart=always
RestartSec=10
Nice=10
MemoryMax=512M
# Environment=MESHATLAS_TOKEN=change-me

[Install]
WantedBy=default.target
